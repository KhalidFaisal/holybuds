generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Product {
  id          String      @id @default(cuid())
  name        String
  category    String      // FLOWER or EDIBLE
  price       Float
  weight      String?     // e.g. "3.5g", "1g", "7g", "1pc", "10pc"
  description String      @default("")
  image       String      @default("")
  images      String      @default("[]")
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  isVisible   Boolean     @default(true)
  effects     String      @default("[]")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  boxItems    BoxItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  customerPhone   String
  deliveryMethod  String      @default("PICKUP") // PICKUP, DELIVERY
  deliveryAddress String      @default("")
  status          String      @default("PENDING") // PENDING, PROCESSING, READY, COMPLETED, CANCELLED
  total           Float
  discountName    String?
  discountAmount  Float       @default(0)
  notes           String      @default("")
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  pointsEarned    Int         @default(0)
  pointsUsed      Int         @default(0)
  rewardUsed      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  driverId        String?
  driver          Driver?     @relation("OrderFulfillment", fields: [driverId], references: [id])
  boxId           String?
  box             InventoryBox? @relation(fields: [boxId], references: [id])
  
  items           OrderItem[]
  driverReferrals DriverReferral[]
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Discount {
  id               String   @id @default(cuid())
  name             String
  type             String   // PERCENTAGE, FIXED
  value            Float
  minOrderValue    Float    @default(0)
  minItemQuantity  Int      @default(0)
  targetType       String   // ENTIRE_ORDER, CATEGORY, SPECIFIC_PRODUCTS
  targetCategory   String?  // FLOWER, EDIBLE
  targetProductIds String?  // JSON array of strings
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Banner {
  id              String   @id @default(cuid())
  title           String   @default("")
  desktopImage    String
  mobileImage     String
  link            String   @default("")
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSettings {
  id                String  @id @default("global")
  sitePassword      String  @default("Holymoly")
  adminPasswordHash String?
  timezone          String  @default("UTC")
  chatbotPrompt     String  @default("You are a helpful, friendly budtender at Elevated Dispensary. Recommend products from our inventory based on the user's needs. Be concise, polite, and use a chill tone.")
  aiModel           String  @default("openai/gpt-4o-mini")
  openRouterApiKey  String?
  groqApiKey        String?
  groqEnabled       Boolean @default(true)
  openRouterEnabled Boolean @default(true)
  enabledGroqModels String  @default("[\"groq/compound\", \"openai/gpt-oss-120b\", \"groq/compound-mini\", \"qwen/qwen3.6-27b\", \"openai/gpt-oss-20b\"]")
  loyaltyEnabled        Boolean @default(true)
  pointsPerDollar       Int     @default(1)
  signupBonus           Int     @default(50)
  aiStaffPicksEnabled   Boolean @default(false)
  aiStaffPicksLastUpdate DateTime?
  driverReferralReward     Float   @default(10.0)
  customerReferralDiscount Float   @default(5.0)
  driverBonusThreshold     Int     @default(10)
  driverBonusAmount        Float   @default(100.0)
  wholesalePassword        String  @default("Onlyholy")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  image     String   @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id              String   @id @default(cuid())
  phone           String   @unique
  phoneVerified   Boolean  @default(false)
  name            String
  address         String?
  points          Int      @default(0)
  totalOrders     Int      @default(0)
  referralCode    String?  @unique
  referredByCode  String?
  referralPaidOut Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
  driverReferrals DriverReferral[]
  
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
}

model ActiveSession {
  id              String   @id @default(cuid())
  sessionToken    String   @unique
  lastActiveAt    DateTime @default(now())
  cartTotal       Float    @default(0)
  itemCount       Int      @default(0)
  currentPath     String   @default("")
  checkoutName    String?
  checkoutPhone   String?
  checkoutAddress String?
}

model Driver {
  id           String           @id @default(cuid())
  name         String
  phone        String?          @unique
  email        String?          @unique
  pin          String           @default("0000") // simple login
  referralCode String           @unique
  isActive     Boolean          @default(true)
  totalEarned  Float            @default(0)
  pendingPayout Float           @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  referrals    DriverReferral[]
  bonuses      DriverBonus[]
  payouts      DriverPayout[]
  fulfilledOrders Order[]       @relation("OrderFulfillment")
  currentBox   InventoryBox?    @relation("DriverCurrentBox")
  handoffsFrom Handoff[]        @relation("HandoffFrom")
  handoffsTo   Handoff[]        @relation("HandoffTo")
}

model DriverReferral {
  id           String   @id @default(cuid())
  driverId     String
  driver       Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id])
  rewardAmount Float
  createdAt    DateTime @default(now())
}

model DriverBonus {
  id            String   @id @default(cuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  bonusAmount   Float
  referralCount Int
  createdAt     DateTime @default(now())
}

model DriverPayout {
  id        String   @id @default(cuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount    Float
  createdAt DateTime @default(now())
}

// NextAuth Models

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  customer      Customer?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model InventoryBox {
  id              String      @id @default(cuid())
  name            String      @unique // e.g., "Box 1"
  currentDriverId String?     @unique
  driver          Driver?     @relation("DriverCurrentBox", fields: [currentDriverId], references: [id])
  items           BoxItem[]
  logs            BoxLog[]
  handoffs        Handoff[]
  orders          Order[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model BoxItem {
  id               String       @id @default(cuid())
  boxId            String
  box              InventoryBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  productId        String
  product          Product      @relation(fields: [productId], references: [id])
  expectedQuantity Int          @default(0)

  @@unique([boxId, productId])
}

model BoxLog {
  id        String       @id @default(cuid())
  boxId     String
  box       InventoryBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  type      String       // RESTOCK, RETURN, AUDIT, HANDOFF
  details   String       @db.Text // JSON with details (what was added/removed/counted)
  createdAt DateTime     @default(now())
}

model Handoff {
  id                String       @id @default(cuid())
  boxId             String
  box               InventoryBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  fromDriverId      String
  fromDriver        Driver       @relation("HandoffFrom", fields: [fromDriverId], references: [id])
  toDriverId        String
  toDriver          Driver       @relation("HandoffTo", fields: [toDriverId], references: [id])
  expectedInventory String       @db.Text // Snapshot of what the system expects
  actualInventory   String       @db.Text // What the next driver physically counted
  discrepancies     String       @db.Text // Differences
  status            String       @default("PENDING") // PENDING, ACCEPTED
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

